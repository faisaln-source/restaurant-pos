{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restaurant POS",
  "version": "1.0.0",
  "identifier": "com.restaurantpos.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../web && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Restaurant POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "api-bundle/app-config.json": "api-bundle/app-config.json",
      "api-bundle/package.json": "api-bundle/package.json",
      "api-bundle/node.exe": "api-bundle/node.exe",
      "api-bundle/dist/.gitkeep": "api-bundle/dist/.gitkeep"
    },
    "externalBin": [
      "binaries/api-server"
    ],
    "copyright": "© 2026 Restaurant POS. All rights reserved.",
    "category": "Business",
    "shortDescription": "Modern Restaurant Point of Sale System",
    "longDescription": "A full-featured POS system for dine-in, takeaway and delivery with real-time kitchen display.",
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}

