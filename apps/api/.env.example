# API Environment Variables for Render
# Database connection string from Render PostgreSQL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secrets (generate strong random strings)
JWT_SECRET="generate-a-secure-random-jwt-secret-key-32-chars-minimum"
JWT_REFRESH_SECRET="generate-a-secure-random-refresh-secret-key-32-chars-minimum"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server & Environment
PORT=10000
NODE_ENV="production"

# Frontend Vercel Origin (can be comma-separated or single URL)
CORS_ORIGIN="https://your-pos-app.vercel.app"

# Payment & Gateway (Optional / Test)
RAZORPAY_KEY_ID="rzp_test_5173testkey"
RAZORPAY_KEY_SECRET="rzp_test_secret_demo123"
RAZORPAY_CURRENCY="INR"
RESTAURANT_UPI_ID="quickserve.pos@okaxis"
RESTAURANT_NAME="QuickServe POS & Dining"
